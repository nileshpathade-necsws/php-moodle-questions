<quiz>

  <!-- ============================================ -->
  <!-- DRAG AND DROP INTO TEXT (ddwtos) - 2 QUESTIONS -->
  <!-- ============================================ -->

  <question type="ddwtos">
    <name><text>PHP DragText 01 - Array declaration</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>Drag the correct syntax element into the blanks to declare a PHP array.</p><pre>$fruits = [[1]] "apple", "banana", "cherry" [[2]];</pre>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <shuffleanswers>1</shuffleanswers>
    <correctfeedback format="html"><text>Correct! Arrays in PHP are enclosed in square brackets.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Check the array syntax in PHP.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>PHP arrays use square brackets [ ] to enclose elements.</text></incorrectfeedback>
    <dragbox><text>[</text><group>1</group></dragbox>
    <dragbox><text>{</text><group>1</group></dragbox>
    <dragbox><text>(</text><group>1</group></dragbox>
    <dragbox><text>]</text><group>2</group></dragbox>
    <dragbox><text>}</text><group>2</group></dragbox>
    <dragbox><text>)</text><group>2</group></dragbox>
  </question>

  <question type="ddwtos">
    <name><text>PHP DragText 02 - Loop structure</text></name>
    <questiontext format="html">
      <text><![CDATA[<p>Drag the correct keywords into the blanks to complete a foreach loop.</p><pre>[[1]] ($array [[2]] $item) {
    echo $item;
}</pre>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <shuffleanswers>1</shuffleanswers>
    <correctfeedback format="html"><text>Correct! foreach iterates over array elements.</text></correctfeedback>
    <partiallycorrectfeedback format="html"><text>Review the foreach loop syntax.</text></partiallycorrectfeedback>
    <incorrectfeedback format="html"><text>The correct syntax is: foreach ($array as $item)</text></incorrectfeedback>
    <dragbox><text>foreach</text><group>1</group></dragbox>
    <dragbox><text>for</text><group>1</group></dragbox>
    <dragbox><text>while</text><group>1</group></dragbox>
    <dragbox><text>as</text><group>2</group></dragbox>
    <dragbox><text>in</text><group>2</group></dragbox>
    <dragbox><text>to</text><group>2</group></dragbox>
  </question>

