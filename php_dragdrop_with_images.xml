  <question type="shortanswer">
    <name><text>PHP Image Marker 01 - Function components</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Identify the marked components in the diagram below:</strong></p>
<p>In the PHP function diagram, label the component marked with <strong>Box A</strong>. Type the exact term:</p>
<img src="@@PLUGINFILE@@/php_function_diagram.png" alt="PHP Function Structure Diagram" style="max-width: 600px; border: 1px solid #ccc; padding: 10px;">
<p><strong>What is component A?</strong></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <usecase>0</usecase>
    <answer fraction="100">
      <text>function</text>
      <feedback format="html"><text>Correct! Component A is the 'function' keyword used to declare a PHP function.</text></feedback>
    </answer>
    <answer fraction="100">
      <text>keyword</text>
      <feedback format="html"><text>Also correct - 'function' is a PHP keyword.</text></feedback>
    </answer>
    <answer fraction="50">
      <text>declaration</text>
      <feedback format="html"><text>Partially correct - this is part of function declaration syntax.</text></feedback>
    </answer>
    <file name="php_function_diagram.png" path="/php_function_diagram.png"/>
  </question>

  <question type="shortanswer">
    <name><text>PHP Image Marker 02 - Array structure</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><strong>Identify the array components in the visual diagram:</strong></p>
<p>Study the array diagram below and answer: What is the value at the position marked by <strong>Box B</strong>?</p>
<img src="@@PLUGINFILE@@/php_array_structure.png" alt="PHP Array Structure Diagram" style="max-width: 600px; border: 1px solid #ccc; padding: 10px;">
<p><strong>Type the exact value shown in Box B (case-sensitive):</strong></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.3333333</penalty>
    <usecase>1</usecase>
    <answer fraction="100">
      <text>banana</text>
      <feedback format="html"><text>Correct! Box B points to the array element with value 'banana' at index 1.</text></feedback>
    </answer>
    <file name="php_array_structure.png" path="/php_array_structure.png"/>
  </question>

</quiz>